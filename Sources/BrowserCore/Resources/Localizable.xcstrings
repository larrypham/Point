    "extensions_open_side_panel": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open side panel"}}, "ru": {"stringUnit": {"state": "translated", "value": "Открыть боковую панель"}}}},
    "extensions_side_panel_runtime_limit": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This extension requests Chrome Debugger or native app integration, which Point does not support. Its panel may open, but these features cannot work."}}, "ru": {"stringUnit": {"state": "translated", "value": "Расширение запрашивает Chrome Debugger или связь с настольным приложением, которые Point не поддерживает. Панель может открыться, но эти функции работать не смогут."}}}},
    "extensions_store_link" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Chrome Web Store link or extension ID"}},"ru": {"stringUnit": {"state": "translated","value": "Ссылка из Chrome Web Store или ID расширения"}}}},
    "extensions_store_install" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Install from Chrome Web Store"}},"ru": {"stringUnit": {"state": "translated","value": "Установить из Chrome Web Store"}}}},
