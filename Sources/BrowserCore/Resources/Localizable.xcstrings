    "extensions_compatibility": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Compatibility depends on the WebExtension APIs supported by WebKit. Store installation, automatic updates and native messaging are not available."}}, "ru": {"stringUnit": {"state": "translated", "value": "Совместимость зависит от API WebExtensions, поддерживаемых WebKit. Установка из магазинов, автообновление и native messaging пока недоступны."}}}},
    "extensions_reload_hint": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reload pages after changing extensions or permissions. Scripts already run on a page remain until it is reloaded."}}, "ru": {"stringUnit": {"state": "translated", "value": "После изменения расширений или разрешений перезагрузите страницы. Уже выполненные скрипты остаются на странице до её перезагрузки."}}}},
    "extensions_background_timeout": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The extension background did not finish starting. Check extension compatibility and try again."}}, "ru": {"stringUnit": {"state": "translated", "value": "Фоновая часть расширения не запустилась вовремя. Проверьте совместимость расширения и попробуйте снова."}}}},
    "adblock_section": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Ad blocking"}}, "ru": {"stringUnit": {"state": "translated", "value": "Блокировка рекламы"}}}},
