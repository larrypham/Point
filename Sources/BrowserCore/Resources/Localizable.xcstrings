    "extensions_store_original" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Original packages are installed without changes. Compatibility depends on WebKit."}},"ru": {"stringUnit": {"state": "translated","value": "Оригинальные пакеты устанавливаются без изменений. Совместимость зависит от WebKit."}}}},
    "extensions_store_invalid_link" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "Paste a Chrome Web Store extension link or its 32-character ID."}},"ru": {"stringUnit": {"state": "translated","value": "Вставьте ссылку на расширение из Chrome Web Store или его ID из 32 символов."}}}},
    "extensions_store_unavailable" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "The store could not provide this extension. Check the link and try again."}},"ru": {"stringUnit": {"state": "translated","value": "Магазин не предоставил расширение. Проверьте ссылку и повторите попытку."}}}},
    "extensions_store_invalid_package" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "The extension package is damaged, unsupported, or its signature could not be verified."}},"ru": {"stringUnit": {"state": "translated","value": "Пакет расширения повреждён, не поддерживается или его подпись не прошла проверку."}}}},
    "extensions_store_too_large" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "This extension exceeds the package size limit."}},"ru": {"stringUnit": {"state": "translated","value": "Расширение превышает допустимый размер пакета."}}}},
    "extensions_store_already_installed" : {"localizations": {"en": {"stringUnit": {"state": "translated","value": "This extension is already installed from Chrome Web Store."}},"ru": {"stringUnit": {"state": "translated","value": "Это расширение уже установлено из Chrome Web Store."}}}},
    "extensions_css_limitation": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Extensions that change website appearance using CSS may not work correctly."}}, "ru": {"stringUnit": {"state": "translated", "value": "Расширения, меняющие оформление сайтов через CSS, могут работать некорректно."}}}},
