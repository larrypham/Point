    "extensions_permissions_detail": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This extension requests the following capabilities and website access. Allow only extensions you trust."}}, "ru": {"stringUnit": {"state": "translated", "value": "Расширение запрашивает следующие возможности и доступ к сайтам. Разрешайте доступ только расширениям, которым доверяете."}}}},
    "extensions_no_permissions": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No capabilities or website access granted."}}, "ru": {"stringUnit": {"state": "translated", "value": "Доступ к возможностям и сайтам не предоставлен."}}}},
