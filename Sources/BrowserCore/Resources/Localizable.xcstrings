    "extensions_description": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Install from Chrome Web Store or a folder on your Mac. Point keeps its own copy."}}, "ru": {"stringUnit": {"state": "translated", "value": "Установите расширение из Chrome Web Store или папки на вашем Mac. Point сохранит собственную копию."}}}},
    "extensions_install_folder": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Install from folder…"}}, "ru": {"stringUnit": {"state": "translated", "value": "Установить из папки…"}}}},
